// Structural equality. `==` compares structure too, but on the Go backend
// it fails at run time for sums and products: Go can't compare the lists
// inside them. `same:` works everywhere.

extend Expr [
  /// Same shape and same leaves. Order matters: `x + y` isn't `y + x`.
  on same(other): Expr -> Bool = | this
  | Num => | other
    | Num => value == other value
    |=> false
  | Sym => | other
    | Sym => name == other name
    |=> false
  | Sum => | other
    | Sum => terms same: other terms
    |=> false
  | Product => | other
    | Product => factors same: other factors
    |=> false
  | Power => | other
    | Power => (base same: other base) && (exp same: other exp)
    |=> false
]

/// Same length, and no pair differs. Lists have no `all:`, and `any:` is
/// missing from the Clojure runtime, hence `filter:`.
List(Expr) same(other): List(Expr) -> Bool =
  this count != other count
    ifTrue: [false]
    ifFalse: [((this mapIndexed: [i, e -> e same: (other at: i)]) filter: [it not]) isEmpty]
