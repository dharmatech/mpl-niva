// Simplifying: Cohen's automatic simplification, as `simplify`. It's
// separate from the operators, which build what's written: `x + y + z`
// is a sum inside a sum, and simplified it's one sum of three terms. It
// works bottom-up, an expression's operands first and then the
// expression.
//
// A sum's terms are merged two lists at a time, and what two terms
// become is up to the pair rule, `sumPair:`; a product's factors
// likewise, with `productPair:`. The algebra of sums and products goes in
// the pair rules. For now two numbers add in a sum and multiply in a
// product, a 0 drops out of a sum and a 1 out of a product, two terms
// that differ only in their number combine, and any other two operands
// are kept and put in Cohen's order, from `order.niva`. So simplifying
// flattens, sorts, works out numbers and combines like terms: a sum's
// sums are spliced into it, a product's products, the merge leaves the
// operands in order, and the numbers, which that order puts first,
// become one or none, as do like terms, which it puts together. A
// product with a 0 among its factors is 0. The two sides are kept apart,
// as in mpl, since their pair rules differ.
//
// A power's rules are Cohen's for integers, in `simplifiedPower:` and
// `integerPower:`: to 0 it's 1 and to 1 its base, 1 to anything is 1, 0
// to a positive number is 0, a number to one that isn't negative is
// worked out, and to a number, a power of a power multiplies the
// exponents and a power of a product is the product of its factors'
// powers. Where Cohen gives Undefined or a fraction, as for `0^0`,
// `0^(-1)` and `2^(-1)`, the power stays as written, since neither is
// here yet. The names in the comments are Cohen's.

extend Expr [
  /// Cohen's automatic_simplify: the operands first, then the node.
  on simplify -> Expr = | this
  | Num     => this
  | Sym     => this
  | Sum     => (terms map: [it simplify]) simplifiedSum
  | Product => (factors map: [it simplify]) simplifiedProduct
  | Power   => base simplify simplifiedPower: exp simplify
]

// Numbers, for the pair rules and powers.

extend Expr [
  /// Whether this is a number.
  on isNum -> Bool = | this
  | Num => true
  |=> false

  /// A number's value. The rules ask it only of numbers; anything else
  /// gives 0.
  on numValue -> Int = | this
  | Num => value
  |=> 0

  /// This as a list of one, or none if it's the number `n`: what two
  /// numbers or like terms make, gone if it's 0 in a sum or 1 in a
  /// product.
  on listUnless(n): Int -> List(Expr) =
    this == n num ifTrue: [{}] ifFalse: [{this}]
]

// Sums.

extend Expr [
  /// Whether this is a sum.
  on isSum -> Bool = | this
  | Sum => true
  |=> false

  /// A sum's terms, or else a list of this one operand.
  on asTerms -> List(Expr) = | this
  | Sum => terms
  |=> {this}

  /// Cohen's term, for an operand that isn't a number: a product's
  /// factors after its number, if it starts with one; any other
  /// product's factors; and anything else as a list of one.
  on termFactors -> List(Expr) = | this
  | Product => factors first isNum ifTrue: [factors drop: 1] ifFalse: [factors]
  |=> {this}

  /// Cohen's constant, for an operand that isn't a number: a product's
  /// number, if it starts with one, and 1 otherwise.
  on constant -> Int = | this
  | Product => factors first isNum ifTrue: [factors first numValue] ifFalse: [1]
  |=> 1

  /// The pair rule: the base case of Cohen's simplify_sum_rec, two
  /// operands that aren't sums. The first case that applies: two numbers
  /// add, and drop out if they make 0; a 0 drops out; two that aren't
  /// numbers and have the same term combine, the sum of their constants
  /// times the term, simplified, and drop out if that's 0; and any other
  /// two are kept, swapped if `other` comes first.
  on sumPair(other): Expr -> List(Expr) = | true
  | this isNum && other isNum => (this numValue + other numValue) num listUnless: 0
  | this == 0 num => {other}
  | other == 0 num => {this}
  | this isNum not && other isNum not && (this termFactors == other termFactors) => [
    c = (this constant + other constant) num
    ({c} + this termFactors) simplifiedProduct listUnless: 0
  ]
  | (other before: this) => {other this}
  |=> {this other}
]

extend List(Expr) [
  /// Cohen's simplify_sum, on simplified terms: none is 0, one is
  /// itself, and more are merged by `sumRec`.
  on simplifiedSum -> Expr =
    this count < 2
      ifTrue: [this asSum]
      ifFalse: [this sumRec asSum]

  /// These terms as one expression: 0 if there are none, the term if
  /// there's one, and their sum if more.
  on asSum -> Expr =
    this isEmpty
      ifTrue: [0 num]
      ifFalse: [this count == 1 ifTrue: [this first] ifFalse: [Sum terms: this]]

  /// Cohen's simplify_sum_rec, on two simplified terms or more: what
  /// they become, in order. Two that aren't sums go to the pair rule.
  /// That test comes first, or merging them would call back here
  /// forever.
  on sumRec -> List(Expr) =
    this count == 2
      ifTrue: [
        p = this first
        q = this last
        p isSum not && q isSum not
          ifTrue: [p sumPair: q]
          ifFalse: [p asTerms mergeSum: q asTerms]
      ]
      ifFalse: [this first asTerms mergeSum: (this drop: 1) sumRec]

  /// Cohen's merge_sums: two lists of terms, each in order, merged. If
  /// one is empty, it's the other. If not, the two first terms go to
  /// `sumRec`: none back, and both are gone; one, and it goes next; both
  /// in order, and this list's goes next; both swapped, and `q`'s does.
  on mergeSum(q): List(Expr) -> List(Expr) =
    this isEmpty || q isEmpty
      ifTrue: [this + q]
      ifFalse: [
        p1 = this first
        q1 = q first
        ps = this drop: 1
        qs = q drop: 1
        h = {p1 q1} sumRec
        | h count
        | 0 => ps mergeSum: qs
        | 1 => h + (ps mergeSum: qs)
        |=> h == {p1 q1}
          ifTrue: [{p1} + (ps mergeSum: q)]
          ifFalse: [{q1} + (this mergeSum: qs)]
      ]
]

// Products, the same with factors.

extend Expr [
  /// Whether this is a product.
  on isProduct -> Bool = | this
  | Product => true
  |=> false

  /// A product's factors, or else a list of this one operand.
  on asFactors -> List(Expr) = | this
  | Product => factors
  |=> {this}

  /// The pair rule: the base case of Cohen's simplify_product_rec, two
  /// operands that aren't products. The first case that applies: two
  /// numbers multiply, and drop out if they make 1; a 1 drops out; and
  /// any other two are kept, swapped if `other` comes first. Later
  /// increments add cases ahead of that last one.
  on productPair(other): Expr -> List(Expr) = | true
  | this isNum && other isNum => (this numValue * other numValue) num listUnless: 1
  | this == 1 num => {other}
  | other == 1 num => {this}
  | (other before: this) => {other this}
  |=> {this other}
]

extend List(Expr) [
  /// Cohen's simplify_product, on simplified factors: any 0 makes it 0,
  /// none is 1, one is itself, and more are merged by `productRec`.
  on simplifiedProduct -> Expr =
    (this any: [it == 0 num])
      ifTrue: [0 num]
      ifFalse: [this count < 2 ifTrue: [this asProduct] ifFalse: [this productRec asProduct]]

  /// These factors as one expression: 1 if there are none, the factor if
  /// there's one, and their product if more.
  on asProduct -> Expr =
    this isEmpty
      ifTrue: [1 num]
      ifFalse: [this count == 1 ifTrue: [this first] ifFalse: [Product factors: this]]

  /// Cohen's simplify_product_rec, on two simplified factors or more:
  /// what they become, in order. Two that aren't products go to the
  /// pair rule. That test comes first, or merging them would call back
  /// here forever.
  on productRec -> List(Expr) =
    this count == 2
      ifTrue: [
        p = this first
        q = this last
        p isProduct not && q isProduct not
          ifTrue: [p productPair: q]
          ifFalse: [p asFactors mergeProduct: q asFactors]
      ]
      ifFalse: [this first asFactors mergeProduct: (this drop: 1) productRec]

  /// Cohen's merge_products: two lists of factors, each in order,
  /// merged. If one is empty, it's the other. If not, the two first
  /// factors go to `productRec`: none back, and both are gone; one, and
  /// it goes next; both in order, and this list's goes next; both
  /// swapped, and `q`'s does.
  on mergeProduct(q): List(Expr) -> List(Expr) =
    this isEmpty || q isEmpty
      ifTrue: [this + q]
      ifFalse: [
        p1 = this first
        q1 = q first
        ps = this drop: 1
        qs = q drop: 1
        h = {p1 q1} productRec
        | h count
        | 0 => ps mergeProduct: qs
        | 1 => h + (ps mergeProduct: qs)
        |=> h == {p1 q1}
          ifTrue: [{p1} + (ps mergeProduct: q)]
          ifFalse: [{q1} + (this mergeProduct: qs)]
      ]
]

// Powers.

/// This to the power `n`, for an `n` that isn't negative.
Int raisedTo(n): Int -> Int =
  n == 0 ifTrue: [1] ifFalse: [this * (this raisedTo: n - 1)]

extend Expr [
  /// Whether this is a power.
  on isPower -> Bool = | this
  | Power => true
  |=> false

  /// A power's base. `integerPower:` asks it only of powers; anything
  /// else gives itself.
  on powerBase -> Expr = | this
  | Power => base
  |=> this

  /// A power's exponent. `integerPower:` asks it only of powers;
  /// anything else gives 1.
  on powerExp -> Expr = | this
  | Power => exp
  |=> 1 num

  /// Cohen's simplify_power, on a simplified base, this, and exponent
  /// `w`. The first case that applies: a 0 base is 0 if `w` is a positive
  /// number, and any other power of 0 is as written, since Cohen's
  /// Undefined isn't here yet; a 1 base is 1; a number `w` goes to
  /// `integerPower:`; and anything else is as written.
  on simplifiedPower(w): Expr -> Expr = | true
  // `(this == 0 num)` in parentheses: NIN types each binary message in a
  // chain on the argument before it, so it would look for `&&` on an Expr
  // (Niva feedback 36).
  | (this == 0 num) && w isNum && (w numValue > 0) => 0 num
  | this == 0 num => Power base: this exp: w
  | this == 1 num => 1 num
  | w isNum => this integerPower: w numValue
  |=> Power base: this exp: w

  /// Cohen's simplify_integer_power, on a simplified base, this, and an
  /// integer `n`. The first case that applies: a number to an `n` that
  /// isn't negative is worked out, and to a negative one falls through to
  /// the last case until there are fractions; to 0 anything is 1, and to
  /// 1 itself; a power `r^s` is `r` to the simplified product `s * n`, an
  /// integer power again if that's a number; a product is the simplified
  /// product of its factors, each to `n`; and anything else is `this^n`.
  on integerPower(n): Int -> Expr = | true
  | this isNum && (n >= 0) => (this numValue raisedTo: n) num
  | n == 0 => 1 num
  | n == 1 => this
  | this isPower => [
    p = {(this powerExp) (n num)} simplifiedProduct
    p isNum
      ifTrue: [this powerBase integerPower: p numValue]
      ifFalse: [Power base: this powerBase exp: p]
  ]
  | this isProduct => (this asFactors map: [it integerPower: n]) simplifiedProduct
  |=> Power base: this exp: n num
]
