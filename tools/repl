#!/usr/bin/env bash
# A Niva REPL: each line you enter runs after the lines already kept, and
# only its own output is shown. A line that fails to build or run isn't
# kept. Ctrl-D ends the session.
#
#   tools/repl                              # Go, by replay
#   tools/repl --backend=clj                # Clojure, live, on the JVM
#   tools/repl --backend=clj --runtime=bb   # or on bb, or lg
#
# On Go, each line runs as a program after the lines kept so far. On
# Clojure, one process keeps the session: it loads the REPL module built
# before any line, then each line's module, built with --repl-line, which
# runs only that line. On JVM Clojure that process also runs NIN, so the
# compiler stays warm; on bb and lg, NIN starts again for each line. lg
# is let-go, which NIN doesn't target; LG names its binary if it's not on
# PATH.
#
# The session is written to repl.niva at the project root, where the
# compiler finds mpl/, and removed at the end. While it runs, other
# builds see its declarations too.
set -uo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
backend=go
runtime=jvm
for arg; do
  case $arg in
    --backend=go | --backend=clj) backend=${arg#*=} ;;
    --runtime=bb | --runtime=jvm | --runtime=lg) runtime=${arg#*=} ;;
    *) echo "repl: unknown option $arg (--backend=go or clj, --runtime=bb, jvm or lg)" >&2; exit 2 ;;
  esac
done
cd "$root"
if [ -e repl.niva ]; then
  echo "repl: repl.niva exists, from another session or one that didn't end; remove it first" >&2
  exit 1
fi
trap 'rm -f repl.niva' EXIT

session=()

# Writes repl.niva: the lines kept so far, then these.
write_session() {
  {
    [ ${#session[@]} -gt 0 ] && printf '%s\n' "${session[@]}"
    printf '%s\n' "$@"
  } > repl.niva
}

# The compiler's message without its own stack trace.
trimmed() {
  grep -v -e '^Method:' -e '^-*$' -e '^ *$' | head -n 6
}

# go_line LINE and clj_line LINE run LINE after the lines kept so far,
# print its output, or why it failed, and fail if it didn't build or run.
marker="-- niva repl: new output --"
go_line() {
  write_session "\"$marker\" echo" "$1"
  local out status
  # The status after the output keeps its trailing newlines, which $(…)
  # would strip, so a line that prints a blank line shows it.
  out=$("$root/tools/nin" run repl.niva --backend=go 2>&1; printf '\n%s' $?)
  status=${out##*$'\n'}
  out=${out%$'\n'*}
  # The compiler exits 0 even when the build fails, so a failed build
  # shows as no marker in the output; a run-time error exits 1.
  if [ "$status" -eq 0 ] && [[ $out == *"$marker"* ]]; then
    out=${out#*"$marker"}
    printf '%s' "${out#$'\n'}"
    return 0
  fi
  printf '%s\n' "${out#*"$marker"}" | trimmed
  return 1
}

clj_line() {
  write_session "$1"
  module "--repl-line=$((${#session[@]} + 1))"
}

# Builds repl.niva's REPL module with these options and loads it into the
# session. On JVM Clojure, the session builds it itself.
module() {
  if [ "$runtime" = jvm ]; then
    request "$*"
  else
    build "$@" && request "$work/.niva_clj/main.clj"
  fi
}

# Builds repl.niva's REPL module, with these options, as
# $work/.niva_clj/main.clj. The compiler writes .niva_clj/ where it runs
# and exits 0 even when the build fails, so this checks what it wrote.
build() {
  rm -f "$work/.niva_clj/main.clj"
  local out
  out=$(cd "$work" && "$root/tools/nin" build "$root/repl.niva" --backend=clj --repl "$@" 2>&1)
  [ -s "$work/.niva_clj/main.clj" ] && return 0
  printf '%s\n' "${out//"$root/"/}" | trimmed
  return 1
}

# Sends the session a request, a module to load or, on JVM Clojure, the
# options to build one with, and prints what it prints. If it fails, this
# prints why and fails.
done_marker="-- niva repl: done --"
failed_marker="-- niva repl: failed --"
request() {
  printf '%s\n' "$1" >&"${clj[1]}"
  local out failed= why=
  while IFS= read -r out <&"${clj[0]}"; do
    case $out in
      "$done_marker")
        [ -z "$failed" ] && return 0
        printf '%s' "${why//"$root/"/}" | trimmed
        return 1 ;;
      "$failed_marker") failed=1 ;;
      *) if [ -n "$failed" ]; then why+=$out$'\n'; else printf '%s\n' "$out"; fi ;;
    esac
  done
  echo "repl: the $runtime session ended" >&2
  exit 1
}

if [ "$backend" = clj ]; then
  # NIN's jar, as tools/nin finds it.
  jar=${NIVA_SELF_HOST:-$HOME/src/Niva-self-host}/Niva/NivaInNiva/main.jar
  case $runtime in
    bb)  bin=bb ;;
    jvm) bin=clojure ;;
    lg)  bin=${LG:-lg} ;;
  esac
  if ! command -v "$bin" > /dev/null; then
    echo "repl: $bin not found" >&2
    exit 1
  fi
  work=$(mktemp -d)
  trap 'rm -f repl.niva; rm -rf "$work"' EXIT
  : > repl.niva
  # The session runs each request on its input as run does. It says when
  # it's done, after the error's root cause if the request failed.
  case $runtime in
    jvm)
      if [ ! -f "$jar" ]; then
        echo "repl: $jar not found; run tools/build-self-hosted-niva" >&2
        exit 1
      fi
      # NIN's main, called in this JVM, prints why a build failed; that
      # is caught, since the session's own output is Clojure's *out*.
      start=(java -cp "$(cd "$work" && clojure -Spath):$jar:.niva_clj" clojure.main serve.clj)
      cat > "$work/serve.clj" <<EOF
(require '[clojure.string :as str])
(defn run [options]
  (let [module (java.io.File. ".niva_clj/main.clj")
        printed (java.io.ByteArrayOutputStream.)
        out System/out
        err System/err]
    (.delete module)
    (System/setOut (java.io.PrintStream. printed true))
    (System/setErr (java.io.PrintStream. printed true))
    (try (mainNiva.MainKt/main
          (into-array String (concat ["build" "$root/repl.niva" "--backend=clj" "--repl"]
                                     (remove str/blank? (str/split options #" ")))))
         (finally (System/setOut out) (System/setErr err)))
    (if (.exists module)
      (load-file (str module))
      (throw (ex-info (str printed) {})))))
EOF
      ;;
    *)
      start=(bb -cp .niva_clj serve.clj)
      [ "$runtime" = lg ] && start=("$bin" -source-paths .niva_clj serve.clj)
      # The same code runs on both, since lg has no load-file.
      echo '(defn run [path] (load-string (slurp path)))' > "$work/serve.clj"
      ;;
  esac
  cat >> "$work/serve.clj" <<EOF
(loop []
  (when-let [request (read-line)]
    (try (run request)
         (catch Throwable e
           (let [cause (loop [e e] (if-let [c (ex-cause e)] (recur c) e))]
             (println "$failed_marker")
             (println (or (ex-message cause) (str cause))))))
    (println "$done_marker")
    (flush)
    (recur)))
EOF
  # The classpath has .niva_clj/ only if it's there when the JVM starts.
  mkdir "$work/.niva_clj"
  coproc clj { cd "$work" && exec "${start[@]}" 2>&1; }
  module || exit 1
fi

while IFS= read -r -e -p "niva> " line; do
  [ -z "$line" ] && continue
  history -s "$line"
  if "${backend}_line" "$line"; then
    session+=("$line")
  else
    echo "(not kept)"
  fi
done
echo
