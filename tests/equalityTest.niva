Test identityIsNotEquality = [
  Assert that: ("x" sym == "x" sym) equals: false
  Assert that: ("x" sym same: "x" sym) equals: true
]

Test leaves = [
  Assert that: (3 num same: 3 num) equals: true
  Assert that: (3 num same: 4 num) equals: false
  Assert that: ("x" sym same: "y" sym) equals: false
  Assert that: (1 num same: "x" sym) equals: false
]

Test operandsInOrder = [
  x = "x" sym
  y = "y" sym
  Assert that: ((x + y) same: (x + y)) equals: true
  Assert that: ((x + y) same: (y + x)) equals: false
  Assert that: ((x + y) same: (x * y)) equals: false
  Assert that: ((Sum terms: {x y}) same: (Sum terms: {x y x})) equals: false
]

Test powers = [
  x = "x" sym
  Assert that: ((x pow: 2 num) same: (x pow: 2 num)) equals: true
  Assert that: ((x pow: 2 num) same: (x pow: 3 num)) equals: false
  Assert that: ((x pow: 2 num) same: (2 num pow: x)) equals: false
]
