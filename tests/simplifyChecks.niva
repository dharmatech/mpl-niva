// Project import: "mpl.notation"
// Project import: "mpl.simplify"
// Project import: "mpl.tree"
// Project import: "tests.checking"

type SimplifyChecks

constructor SimplifyChecks all -> List(Check) = [
  a = "a" sym
  b = "b" sym
  c = "c" sym
  d = "d" sym
  e = "e" sym
  x = "x" sym
  y = "y" sym
  z = "z" sym
  none::List(Expr) = {}
  {
    (Check named: "flatten: (a + b) + c" got: (a + b + c) simplify text want: "a + b + c")
    (Check named: "flatten: a + (b + c)" got: (a + (b + c)) simplify text want: "a + b + c")
    (Check named: "flatten: ((a + b) + c) + d" got: (a + b + c + d) simplify text want: "a + b + c + d")
    (Check named: "flatten: (a * b) * c" got: (a * b * c) simplify text want: "a * b * c")
    (Check named: "flatten: a * (b * c)" got: (a * (b * c)) simplify text want: "a * b * c")
    (Check named: "flatten: (a + b) * (c + d)" got: ((a + b) * (c + d)) simplify text want: "(a + b) * (c + d)")
    (Check named: "flatten: (a + (b + c))^2" got: ((a + (b + c)) pow: 2 num) simplify text want: "(a + b + c)^2")

    // Three operands or more take another path through the merge.
    (Check named: "flatten: (a + b) + c + (d + e)" got: (Sum terms: {(a + b) c (d + e)}) simplify text want: "a + b + c + d + e")
    (Check named: "flatten: (a * b) * c * (d * e)" got: (Product factors: {(a * b) c (d * e)}) simplify text want: "a * b * c * d * e")

    // One operand is that operand. Its text can't tell, so `==`.
    (Check named: "one term: Sum terms: {x}" holds: (Sum terms: {x}) simplify == x)
    (Check named: "one factor: Product factors: {x}" holds: (Product factors: {x}) simplify == x)
    (Check named: "one term: Sum terms: {a + b}" got: (Sum terms: {(a + b)}) simplify text want: "a + b")

    (Check named: "no terms: Sum terms: {}" got: (Sum terms: none) simplify text want: "0")
    (Check named: "no factors: Product factors: {}" got: (Product factors: none) simplify text want: "1")

    // Operands in Cohen's order. Each result is final: one number at
    // most, and no two operands with the same term or base.
    (Check named: "order: y + x" got: (y + x) simplify text want: "x + y")
    (Check named: "order: x + 2" got: (x + 2 num) simplify text want: "2 + x")
    (Check named: "order: (c + a) + b" got: (c + a + b) simplify text want: "a + b + c")
    (Check named: "order: y * x" got: (y * x) simplify text want: "x * y")
    (Check named: "order: x * 3" got: (x * 3 num) simplify text want: "3 * x")
    (Check named: "order: x^2 + x" got: ((x pow: 2 num) + x) simplify text want: "x + x^2")
    (Check named: "order: x * y + y" got: (x * y + y) simplify text want: "y + x * y")
    (Check named: "order: b * c + a * c" got: (b * c + (a * c)) simplify text want: "a * c + b * c")
    (Check named: "order: Sum terms: {d b c a}" got: (Sum terms: {d b c a}) simplify text want: "a + b + c + d")
    (Check named: "order: Product factors: {c a b}" got: (Product factors: {c a b}) simplify text want: "a * b * c")
    // The list 001's sort check sorts, as a sum.
    (Check named: "order: x * y + y + x^2 + x + 2" got: (Sum terms: {(x * y) y (x pow: 2 num) x (2 num)}) simplify text want: "2 + x + x^2 + y + x * y")

    // Numbers add in a sum and multiply in a product, a 0 drops out of
    // a sum and a 1 out of a product, and a product with a 0 is 0. Each
    // result is final: no two operands with the same term or base.
    (Check named: "numbers: 2 + 3" got: (2 num + 3 num) simplify text want: "5")
    (Check named: "numbers: 2 + -2" got: (2 num + -2 num) simplify text want: "0")
    (Check named: "numbers: (x + 2) + 3" got: (x + 2 num + 3 num) simplify text want: "5 + x")
    (Check named: "numbers: x + 0" got: (x + 0 num) simplify text want: "x")
    (Check named: "numbers: 0 + x" got: (0 num + x) simplify text want: "x")
    (Check named: "numbers: (x + 2) + -2" got: (x + 2 num + -2 num) simplify text want: "x")
    (Check named: "numbers: Sum terms: {1 x 2 y 3}" got: (Sum terms: {(1 num) x (2 num) y (3 num)}) simplify text want: "6 + x + y")
    (Check named: "numbers: 2 * 3" got: (2 num * 3 num) simplify text want: "6")
    (Check named: "numbers: (x * 2) * 3" got: (x * 2 num * 3 num) simplify text want: "6 * x")
    (Check named: "numbers: x * 1" got: (x * 1 num) simplify text want: "x")
    (Check named: "numbers: 1 * x" got: (1 num * x) simplify text want: "x")
    // Two numbers that make 1 drop out, leaving one factor.
    (Check named: "numbers: (-1 * x) * -1" got: (-1 num * x * -1 num) simplify text want: "x")
    (Check named: "numbers: Product factors: {2 x 3 y}" got: (Product factors: {(2 num) x (3 num) y}) simplify text want: "6 * x * y")
    (Check named: "numbers: x * 0" got: (x * 0 num) simplify text want: "0")
    (Check named: "numbers: 0 * (x + y)" got: (0 num * (x + y)) simplify text want: "0")
    (Check named: "numbers: (2 + 3) * x" got: ((2 num + 3 num) * x) simplify text want: "5 * x")
    (Check named: "numbers: x^(1 + 1)" got: (x pow: 1 num + 1 num) simplify text want: "x^2")

    // Terms that differ only in their number combine in a sum, their
    // numbers added; a 1 then drops out, and a 0 makes the term go. Each
    // result is final: no two factors with the same base in a term.
    (Check named: "like terms: x + x" got: (x + x) simplify text want: "2 * x")
    (Check named: "like terms: 2 * x + 3 * x" got: ((2 num * x) + (3 num * x)) simplify text want: "5 * x")
    (Check named: "like terms: -3 * x + 3 * x" got: ((-3 num * x) + (3 num * x)) simplify text want: "0")
    (Check named: "like terms: x + y + x" got: (x + y + x) simplify text want: "2 * x + y")
    (Check named: "like terms: x * y + y * x" got: ((x * y) + (y * x)) simplify text want: "2 * x * y")
    (Check named: "like terms: 2 * x + -1 * x" got: ((2 num * x) + (-1 num * x)) simplify text want: "x")
    (Check named: "like terms: x^2 + x^2" got: ((x pow: 2 num) + (x pow: 2 num)) simplify text want: "2 * x^2")
    (Check named: "like terms: (a + b) + (a + b)" got: ((a + b) + (a + b)) simplify text want: "2 * a + 2 * b")
    // A constant of 1 on one side.
    (Check named: "like terms: x + 2 * x" got: (x + (2 num * x)) simplify text want: "3 * x")
    // The numbers cancel, then the terms combine.
    (Check named: "like terms: (x + 1) + (x + -1)" got: ((x + 1 num) + (x + -1 num)) simplify text want: "2 * x")
    // Terms that make 0 drop out, leaving the rest.
    (Check named: "like terms: (-3 * x + y) + 3 * x" got: ((-3 num * x) + y + (3 num * x)) simplify text want: "y")
    (Check named: "like terms: Sum terms: {x y x y x}" got: (Sum terms: {x y x y x}) simplify text want: "3 * x + 2 * y")
    // A term of two factors.
    (Check named: "like terms: 2 * (x * y) + x * y" got: ((2 num * (x * y)) + (x * y)) simplify text want: "3 * x * y")
    // Unlike terms stay apart.
    (Check named: "like terms: x + x * y" got: (x + (x * y)) simplify text want: "x + x * y")
    (Check named: "like terms: 2 * x + 2 * y" got: ((2 num * x) + (2 num * y)) simplify text want: "2 * x + 2 * y")

    // Powers, by Cohen's rules for integers. Each result is final: no
    // product whose factors share a base, and no negative power of a
    // number.
    (Check named: "powers: x^0" got: (x pow: 0 num) simplify text want: "1")
    (Check named: "powers: x^1" got: (x pow: 1 num) simplify text want: "x")
    (Check named: "powers: 1^x" got: (1 num pow: x) simplify text want: "1")
    (Check named: "powers: 0^3" got: (0 num pow: 3 num) simplify text want: "0")
    (Check named: "powers: 2^3" got: (2 num pow: 3 num) simplify text want: "8")
    (Check named: "powers: (-2)^3" got: (-2 num pow: 3 num) simplify text want: "-8")
    (Check named: "powers: (x^2)^3" got: ((x pow: 2 num) pow: 3 num) simplify text want: "x^6")
    (Check named: "powers: (x^y)^2" got: ((x pow: y) pow: 2 num) simplify text want: "x^(2 * y)")
    (Check named: "powers: (x^-1)^-1" got: ((x pow: -1 num) pow: -1 num) simplify text want: "x")
    (Check named: "powers: (x * y)^2" got: ((x * y) pow: 2 num) simplify text want: "x^2 * y^2")
    (Check named: "powers: (2 * x)^3" got: ((2 num * x) pow: 3 num) simplify text want: "8 * x^3")
    (Check named: "powers: (x^2)^y" got: ((x pow: 2 num) pow: y) simplify text want: "(x^2)^y")
    (Check named: "powers: (x + y)^2" got: ((x + y) pow: 2 num) simplify text want: "(x + y)^2")
    // Undefined will change what 0^0 and 0^(-1) are, so these don't pin
    // them.
    (Check named: "powers: 0^0 isn't 1" holds: ((0 num pow: 0 num) simplify == 1 num) not)
    (Check named: "powers: 0^(-1) isn't 0" holds: ((0 num pow: -1 num) simplify == 0 num) not)
    // A base or exponent that simplifies to a number.
    (Check named: "powers: 2^0" got: (2 num pow: 0 num) simplify text want: "1")
    (Check named: "powers: (1 + 1)^3" got: (1 num + 1 num pow: 3 num) simplify text want: "8")
    (Check named: "powers: x^(2 + -2)" got: (x pow: 2 num + -2 num) simplify text want: "1")
    // A power of a power: the exponents' product, a number or not.
    (Check named: "powers: (x^2)^(-1)" got: ((x pow: 2 num) pow: -1 num) simplify text want: "x^(-2)")
    (Check named: "powers: (x^y)^z" got: ((x pow: y) pow: z) simplify text want: "(x^y)^z")
    (Check named: "powers: (x^(2 * y))^3" got: ((x pow: 2 num * y) pow: 3 num) simplify text want: "x^(6 * y)")
    // A power of a product: its factors' powers, then their product
    // simplified, so a 1 drops out.
    (Check named: "powers: (-1 * x)^2" got: ((-1 num * x) pow: 2 num) simplify text want: "x^2")
    (Check named: "powers: ((x * y)^2)^3" got: (((x * y) pow: 2 num) pow: 3 num) simplify text want: "x^6 * y^6")
    // A power rule, then like terms.
    (Check named: "powers: (x^1)^2 + x^2" got: (((x pow: 1 num) pow: 2 num) + (x pow: 2 num)) simplify text want: "2 * x^2")

    // Factors with the same base combine in a product, their exponents
    // added, and drop out if they make 1. A number has no base, so it
    // stays apart from a power of it.
    (Check named: "like factors: x * x" got: (x * x) simplify text want: "x^2")
    (Check named: "like factors: x^2 * x^3" got: ((x pow: 2 num) * (x pow: 3 num)) simplify text want: "x^5")
    (Check named: "like factors: x * x^2" got: (x * (x pow: 2 num)) simplify text want: "x^3")
    (Check named: "like factors: x^2 * x^-2" got: ((x pow: 2 num) * (x pow: -2 num)) simplify text want: "1")
    (Check named: "like factors: x^2 * x^-1" got: ((x pow: 2 num) * (x pow: -1 num)) simplify text want: "x")
    (Check named: "like factors: x * y * x" got: (x * y * x) simplify text want: "x^2 * y")
    (Check named: "like factors: x^y * x^z" got: ((x pow: y) * (x pow: z)) simplify text want: "x^(y + z)")
    (Check named: "like factors: 2 * x * 3 * x" got: (2 num * x * 3 num * x) simplify text want: "6 * x^2")
    (Check named: "like factors: (x + y) * (x + y)" got: ((x + y) * (x + y)) simplify text want: "(x + y)^2")
    (Check named: "like factors: 2^x * 2^y" got: ((2 num pow: x) * (2 num pow: y)) simplify text want: "2^(x + y)")
    (Check named: "like factors: 2 * 2^x" got: (2 num * (2 num pow: x)) simplify text want: "2 * 2^x")
    (Check named: "like factors: x * x + x^2" got: ((x * x) + (x pow: 2 num)) simplify text want: "2 * x^2")
    (Check named: "like factors: x * x * x" got: (x * x * x) simplify text want: "x^3")
    // Factors that make 1 drop out, leaving the rest.
    (Check named: "like factors: x^2 * y * x^-2" got: ((x pow: 2 num) * y * (x pow: -2 num)) simplify text want: "y")
    // A power of a product, then like factors.
    (Check named: "like factors: (x * y)^2 * x" got: (((x * y) pow: 2 num) * x) simplify text want: "x^3 * y^2")
    (Check named: "like factors: (x * y) * (x * y)^-1" got: ((x * y) * ((x * y) pow: -1 num)) simplify text want: "1")
    // The number second, so it's `other` in the pair rule.
    (Check named: "like factors: 2^x * 2" got: ((2 num pow: x) * 2 num) simplify text want: "2 * 2^x")
  }
]
